# Component refs the Kubernetes e2e lane builds when it runs on a pull request
# (label kubernetes-e2e). A manual dispatch overrides them with its inputs.
# GATEWAY_REF, when set, builds the gateway image from another platform ref.
# The operator contract fix is on main; the gateway fix (platform#145) is not
# yet, so the gateway image builds from its branch. Empty GATEWAY_REF once merged.
PLATFORM_REF=main
GATEWAY_REF=fix/gateway-operator-contract
AGENT_RUNTIME_REF=main
SDK_PYTHON_REF=main
TRACE_PROXY_REF=main
