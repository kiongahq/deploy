# Component refs the Kubernetes e2e lane builds when it runs on a pull request
# (label kubernetes-e2e). A manual dispatch overrides them with its inputs.
# PLATFORM_REF names the operator controllers branch until it merges; set it
# back to main then (the lane fails once that branch is deleted).
PLATFORM_REF=feat/kubernetes-workload-controllers
AGENT_RUNTIME_REF=main
SDK_PYTHON_REF=main
TRACE_PROXY_REF=main
