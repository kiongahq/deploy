# Kionga environment. Copy to .env and fill in.
# .env is gitignored — never commit it.

# ---- public hosting (compose.public.yaml) ----------------------------------
# DNS name pointing at this VM; Caddy provisions TLS for it automatically.
MLAIOPS_DOMAIN=platform.example.com
MLAIOPS_ACME_EMAIL=you@example.com

# OIDC (Dex) console login: Dex's own email + password admin account.
DEX_ADMIN_EMAIL=you@example.com
# bcrypt hash; generate with:
#   docker run --rm httpd:2.4-alpine htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
DEX_ADMIN_PASSWORD_HASH=
# random secret for the console OAuth client, e.g. `openssl rand -hex 24`
DEX_CLIENT_SECRET=

# Break-glass local admin next to single sign-on (required in public mode).
MLAIOPS_LOCAL_PASSWORD=

# Shared bearer token protecting internal service APIs, e.g. `openssl rand -hex 24`
# Services presenting it get the "service" role (reporting endpoints only).
MLAIOPS_INTERNAL_TOKEN=

# Every credential below has a local default in compose.yaml. For public mode,
# uncomment and set each one: it refuses to start while any is unset or equal to
# a local default
# (scripts/public-preflight.sh). Generate each with `openssl rand -hex 24`; hex
# keeps the Postgres password safe inside connection URLs.
# POSTGRES_PASSWORD is applied when the database volume is first created. On an
# existing volume, also run:
#   docker compose exec postgres psql -U mlaiops -c "ALTER ROLE mlaiops PASSWORD '<new>'"
#POSTGRES_PASSWORD=
#OBJECTSTORE_ACCESS_KEY=
#OBJECTSTORE_SECRET_KEY=
# Langfuse is published at https://$MLAIOPS_DOMAIN/langfuse.
# Keys keep their prefixes: pk-lf-$(openssl rand -hex 16) and sk-lf-$(openssl rand -hex 16).
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_NEXTAUTH_SECRET=
#LANGFUSE_SALT=
#LANGFUSE_INIT_USER_PASSWORD=
#JUPYTER_TOKEN=
#IDE_PASSWORD=
#KIONGA_WORKSPACE_JOB_TOKEN=
#KIONGA_WORKSPACE_API_TOKEN=
#KIONGA_DESIGNER_RUNNER_TOKEN=
#LANGFLOW_SUPERUSER_PASSWORD=
#LANGFLOW_SECRET_KEY=
# Agent team sandboxes. The host needs gVisor: public-up.sh stops unless a container
# really runs under it. The token is at least 32 characters, from openssl rand -hex 24.
# Images are comma-separated, each as repository@sha256:digest. Locally, while this
# is empty, sandbox tools report sandbox_unavailable.
#KIONGA_SANDBOX_TOKEN=
#KIONGA_SANDBOX_IMAGES=
# Hosts git may reach over HTTPS, comma-separated. Empty refuses git tools.
#KIONGA_SANDBOX_GIT_HOSTS=
# Put KIONGA_KB_SECRET_* and KIONGA_CONNECTION_SECRET_* values in
# config/secrets/gateway.env, not here: the gateway only receives names listed in
# compose.yaml. To keep a stored reference under another name, also list it here:
#KIONGA_KB_SECRET_REFS=
#KIONGA_CONNECTION_SECRET_REFS=
# Agent team tuning. Empty uses the gateway's default.
#KIONGA_AGENT_TURN_TIMEOUT_SECONDS=
#KIONGA_TEAM_COMPACT_THRESHOLD_TOKENS=
#KIONGA_TEAM_WORKER_POOL=
#KIONGA_TEAM_SANDBOX_RETENTION_SECONDS=
# off stops this gateway's team scheduler.
#KIONGA_TEAM_SCHEDULER=
# LOCAL DEVELOPMENT ONLY, and off by default. A machine without gVisor reports
# sandboxes as unavailable. These two lines run agent code under a weaker runtime
# that does not contain a kernel exploit. Public mode refuses them.
#KIONGA_SANDBOX_RUNTIME=runc
#KIONGA_SANDBOX_ALLOW_UNSAFE_RUNTIME=1
# Required only with KIONGA_SSO_LDAP=true.
#DEX_LDAP_BIND_PASSWORD=

# ---- local network exposure ----------------------------------------------------
# Host address for every port the local stack publishes. The default keeps them on
# this machine: the local stack uses development credentials. Set 0.0.0.0 only on
# a trusted network. Jupyter and the log exporter stay on 127.0.0.1 regardless.
#KIONGA_BIND_ADDRESS=127.0.0.1

# ---- sign-in and sign-up (local and public) ------------------------------------
# approval (default: an access request for an administrator) | open | off
#KIONGA_SIGNUP=approval
#KIONGA_SIGNUP_EMAIL_DOMAINS=example.com
#KIONGA_SIGNUP_PROFILE=starter
# OAuth providers through Dex. Callback URL: <Dex issuer>/callback, locally
# http://localhost:5556/dex/callback. Apply with `make sso-reload`.
#KIONGA_GITHUB_CLIENT_ID=
#KIONGA_GITHUB_CLIENT_SECRET=
#KIONGA_GITHUB_ORG=
#KIONGA_GOOGLE_CLIENT_ID=
#KIONGA_GOOGLE_CLIENT_SECRET=
#KIONGA_GOOGLE_HOSTED_DOMAIN=
#KIONGA_GITLAB_CLIENT_ID=
#KIONGA_GITLAB_CLIENT_SECRET=
#KIONGA_GITLAB_URL=https://gitlab.com
#KIONGA_MICROSOFT_CLIENT_ID=
#KIONGA_MICROSOFT_CLIENT_SECRET=
#KIONGA_MICROSOFT_TENANT=common
# LDAP: the local stack uses a test directory; point these at yours.
#KIONGA_SSO_LDAP=true
#KIONGA_LDAP_HOST=ldap.example.com:636
#KIONGA_LDAP_INSECURE_NO_SSL=false
#KIONGA_LDAP_BIND_DN=cn=dex,ou=svcaccts,dc=example,dc=com
#DEX_LDAP_BIND_PASSWORD=
#KIONGA_LDAP_BASE_DN=dc=example,dc=com
#KIONGA_LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=com
#KIONGA_SSO_DEMO=true

# ---- Jupyter workbench ---------------------------------------------------------
# Login token for the JupyterLab workbench at http://localhost:8888: JUPYTER_TOKEN above.
# The IDE uses the Kionga session through /workspace?tool=ide.
# Optional non-interactive CLI prefix for `kionga scaffold --agent custom`.
#KIONGA_CUSTOM_AGENT_COMMAND=your-agent --non-interactive

# ---- RBAC ---------------------------------------------------------------------
# Roles: admin | operator (full control), user (admin-provisioned entitlements),
# engineer (legacy ML lifecycle, no platform connections), viewer (read-only).
# In OIDC mode roles come from the token's
# "roles" (or "groups") claim — grant them in Dex/your IdP. Locally, without
# OIDC, every request acts as MLAIOPS_LOCAL_ROLE (default: admin).
#MLAIOPS_LOCAL_ROLE=admin
# Local console credentials. Change these outside a throwaway workstation.
#MLAIOPS_LOCAL_USERNAME=admin
#MLAIOPS_LOCAL_PASSWORD=mlaiops-local

# ---- LLM providers (agents) -------------------------------------------------
# Backend: openai | anthropic | openai-compatible | mock (default: mock, no keys needed)
MLAIOPS_LLM_BACKEND=mock
MLAIOPS_LLM_MODEL=
# Used directly by the Jupyter and IDE workspaces. Agents do not read it: their
# calls go through the trace proxy, which holds the provider key below.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Where agent LLM calls egress (default: the trace proxy for full capture). To
# use another provider, change LLM_UPSTREAM_URL rather than bypassing the proxy.
#MLAIOPS_LLM_BASE_URL=http://trace-proxy:8081/v1
# Upstream the trace proxy forwards to (default: https://api.openai.com).
#LLM_UPSTREAM_URL=https://api.anthropic.com
# Provider key the trace proxy sends upstream. Leave empty for a self-hosted
# server that needs no credential. OpenAI: move your key here from OPENAI_API_KEY.
#LLM_UPSTREAM_API_KEY=
# Header and prefix for that key. Default: Authorization: Bearer <key>.
# Anthropic uses x-api-key and Azure OpenAI uses api-key, both without a prefix.
#LLM_UPSTREAM_AUTH_HEADER=x-api-key
#LLM_UPSTREAM_AUTH_SCHEME=
# Project key agents use to call the trace proxy, and the proxy's list of hashed
# keys. There is no default. `make local-up` generates both for local use; every
# other deployment sets them here and keeps them private:
#   key=$(openssl rand -hex 32)
#   hash=$(printf %s "$key" | openssl dgst -sha256 -r | cut -d' ' -f1)
#   echo "TRACE_PROXY_PROJECT_KEY=$key"
#   echo "TRACE_PROXY_KEYS='[{\"key_id\":\"agents\",\"key_sha256\":\"$hash\",\"project\":\"default\"}]'"
#TRACE_PROXY_PROJECT_KEY=
#TRACE_PROXY_KEYS=

# ---- Model artifact reader -----------------------------------------------------
# Read-only object-store user the serving manager downloads model artifacts with.
# objectstore-init creates it. No default: `make local-up` generates both, and
# other deployments set them with: openssl rand -hex 24
#SERVING_OBJECTSTORE_ACCESS_KEY=
#SERVING_OBJECTSTORE_SECRET_KEY=

# ---- Langfuse ----------------------------------------------------------------
# Local defaults exist; public mode requires the values set above.
#LANGFUSE_INIT_USER_EMAIL=

# ---- serverless (OpenFaaS/faasd on the VM) -----------------------------------
#OPENFAAS_URL=http://faasd:8080
#OPENFAAS_USER=admin
#OPENFAAS_PASSWORD=

# ---- deterministic LLM cost rates (USD per 1k tokens) -------------------------
#MLAIOPS_COST_PER_1K_INPUT=0
#MLAIOPS_COST_PER_1K_OUTPUT=0

# ---- real-time demos -----------------------------------------------------------
# Wire the demos to live components once they exist:
#CALLCENTER_AGENT_ID=agt-...
#FRAUD_MODEL_ENDPOINT=http://mlaiops-serve-churn-classifier:5001
# Workspace links use the authenticated gateway, independent of published ports.
# On hosted deployments, {subject} expands to the SHA-256 hex digest of the OIDC
# subject and MUST route to that user's provisioned, isolated upstream.
KIONGA_JUPYTER_UPSTREAM=http://jupyter:8888
KIONGA_IDE_UPSTREAM=http://ide:8080
KIONGA_JUPYTER_TOKEN=mlaiops-local
# Kubernetes: namespace containing the operator-provisioned KiongaWorkspace CRs.
# Discovery resolves each subject's Service and generated authentication Secret.
#KIONGA_WORKSPACE_NAMESPACE=default
# Optional: base64-encoded 32-byte AES key for encrypted personal Hub credentials.
# Generate with: openssl rand -base64 32. Keep stable, private, and backed up.
KIONGA_CREDENTIAL_KEY=
# Opt-in Agno runtime: set runtime,agno, configure AGNO_MODEL and OPENAI_API_KEY,
# and MLAIOPS_GRAPH_MODULE=agents.framework_examples:build_agno, then rebuild.
AGENT_RUNTIME_EXTRAS=runtime
AGNO_MODEL=

# GitHub repository integration (separate from the Dex GitHub login connector).
# Register a GitHub App with repository metadata/content read permissions.
# Use the console origin plus /api/v1/settings/github/callback for OAuth;
# use the console origin plus /console/settings as the app installation setup URL.
#KIONGA_GITHUB_APP_SLUG=
#KIONGA_GITHUB_APP_CLIENT_ID=
#KIONGA_GITHUB_APP_CLIENT_SECRET=
#KIONGA_GITHUB_APP_CALLBACK_URL=
