# Kionga environment. Copy to .env and fill in.
# .env is gitignored — never commit it.

# ---- public hosting (compose.public.yaml) ----------------------------------
# DNS name pointing at this VM; Caddy provisions TLS for it automatically.
MLAIOPS_DOMAIN=platform.example.com
MLAIOPS_ACME_EMAIL=you@example.com

# OIDC (Dex) console login.
DEX_ADMIN_EMAIL=you@example.com
# bcrypt hash; generate with:
#   docker run --rm httpd:2.4-alpine htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
DEX_ADMIN_PASSWORD_HASH=
# random secret for the console OAuth client, e.g. `openssl rand -hex 24`
DEX_CLIENT_SECRET=

# Shared bearer token protecting internal service APIs, e.g. `openssl rand -hex 24`
# Services presenting it get the "service" role (reporting endpoints only).
MLAIOPS_INTERNAL_TOKEN=

# ---- Jupyter workbench ---------------------------------------------------------
# Login token for the JupyterLab workbench at http://localhost:8888
#JUPYTER_TOKEN=mlaiops-local
# The IDE uses the Kionga session through /workspace.html?tool=ide.
# Optional non-interactive CLI prefix for `kionga scaffold --agent custom`.
#KIONGA_CUSTOM_AGENT_COMMAND=your-agent --non-interactive

# ---- RBAC ---------------------------------------------------------------------
# Roles: admin | operator (full control), user (admin-provisioned entitlements),
# engineer (legacy ML lifecycle, no platform connections), viewer (read-only).
# In OIDC mode roles come from the token's
# "roles" (or "groups") claim — grant them in Dex/your IdP. Locally, without
# OIDC, every request acts as MLAIOPS_LOCAL_ROLE (default: admin).
#MLAIOPS_LOCAL_ROLE=admin
# Local console credentials. Change these outside a throwaway workstation.
#MLAIOPS_LOCAL_USERNAME=admin
#MLAIOPS_LOCAL_PASSWORD=mlaiops-local

# ---- LLM providers (agents) -------------------------------------------------
# Backend: openai | anthropic | openai-compatible | mock (default: mock, no keys needed)
MLAIOPS_LLM_BACKEND=mock
MLAIOPS_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Where agent LLM calls egress (default: the trace proxy for full capture).
#MLAIOPS_LLM_BASE_URL=http://trace-proxy:8081/v1
# Upstream the trace proxy forwards to (default: https://api.openai.com).
#LLM_UPSTREAM_URL=https://api.anthropic.com

# ---- Langfuse ----------------------------------------------------------------
# Local defaults exist; override both for anything public.
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_NEXTAUTH_SECRET=
#LANGFUSE_SALT=
#LANGFUSE_INIT_USER_EMAIL=
#LANGFUSE_INIT_USER_PASSWORD=

# ---- serverless (OpenFaaS/faasd on the VM) -----------------------------------
#OPENFAAS_URL=http://faasd:8080
#OPENFAAS_USER=admin
#OPENFAAS_PASSWORD=

# ---- deterministic LLM cost rates (USD per 1k tokens) -------------------------
#MLAIOPS_COST_PER_1K_INPUT=0
#MLAIOPS_COST_PER_1K_OUTPUT=0

# ---- real-time demos -----------------------------------------------------------
# Wire the demos to live components once they exist:
#CALLCENTER_AGENT_ID=agt-...
#FRAUD_MODEL_ENDPOINT=http://mlaiops-serve-churn-classifier:5001
# Workspace links use the authenticated gateway, independent of published ports.
# On hosted deployments, {subject} expands to the SHA-256 hex digest of the OIDC
# subject and MUST route to that user's provisioned, isolated upstream.
KIONGA_JUPYTER_UPSTREAM=http://jupyter:8888
KIONGA_IDE_UPSTREAM=http://ide:8080
KIONGA_JUPYTER_TOKEN=mlaiops-local
# Kubernetes: namespace containing the operator-provisioned KiongaWorkspace CRs.
# Discovery resolves each subject's Service and generated authentication Secret.
#KIONGA_WORKSPACE_NAMESPACE=default
# Optional: base64-encoded 32-byte AES key for encrypted personal Hub credentials.
# Generate with: openssl rand -base64 32. Keep stable, private, and backed up.
KIONGA_CREDENTIAL_KEY=
# Opt-in Agno runtime: set runtime,agno, configure AGNO_MODEL and OPENAI_API_KEY,
# and MLAIOPS_GRAPH_MODULE=agents.framework_examples:build_agno, then rebuild.
AGENT_RUNTIME_EXTRAS=runtime
AGNO_MODEL=
