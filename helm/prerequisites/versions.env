# Pinned prerequisite versions for helm/prerequisites/install.sh. Each was
# released at least two weeks before it was pinned. Bump one at a time and run
# the Kubernetes e2e workflow before merging.
CERT_MANAGER_VERSION=v1.21.3
KEDA_VERSION=2.21.0
KEDA_HTTP_ADDON_VERSION=0.16.0
KSERVE_VERSION=v0.21.0
# Secrets: OpenBao (MPL-2.0, chart from openbao/openbao-helm), External Secrets
# Operator (Apache-2.0) and Reloader (Apache-2.0), which rolls Kionga pods when
# a Secret they mount changes. Never HashiCorp Vault (BUSL).
# OpenBao 2.7.3 (2026-11-19) is pinned before the two-week mark: it fixes
# GHSA-h8fh-pmch-cjww (request forwarding from standbys, which a three-server
# cluster does) and GHSA-fgmw-h9wp-wc7g, and it is the version the platform's
# transit tests run against. Chart 0.30.8 ships it; its values match 0.30.7.
OPENBAO_CHART_VERSION=0.30.8
OPENBAO_VERSION=2.7.3
# quay.io/openbao/openbao:2.7.3, multi-architecture index digest.
OPENBAO_IMAGE_DIGEST=sha256:ba4b133eb9586630024e71a617e66f37f29cc3534cdd46a6233e098ceded8dc9
EXTERNAL_SECRETS_VERSION=2.15.0
RELOADER_CHART_VERSION=2.2.20
# Only for --ingress traefik (the kind lane, or a cluster without a controller).
TRAEFIK_CHART_VERSION=42.2.0
